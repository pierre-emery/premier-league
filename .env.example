# Copier ce fichier en .env puis remplir les valeurs. Le fichier .env n'est jamais commité.

# Dossier où les données sont mises en cache (par défaut : ./data à la racine du dépôt)
PLPREDICT_DATA_DIR=

# Clé API Weights & Biases (https://wandb.ai/authorize)
WANDB_API_KEY=

# Entité et projet W&B
WANDB_ENTITY=
WANDB_PROJECT=premier-league-predictor
